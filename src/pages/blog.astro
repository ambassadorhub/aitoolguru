---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Blog">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-8">Latest Reviews</h1>
    
    <article class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <h2 class="text-2xl font-bold mb-2">
        <a href="/" class="text-blue-600 hover:text-blue-800">Best AI Tools for Small Business UK 2026: The Complete Guide</a>
      </h2>
      <p class="text-gray-600 mb-4">March 2026</p>
      <p class="text-gray-700">Discover the best AI tools for small business in the UK in 2026. Honest reviews, real pricing, and recommendations for marketing, productivity, customer service, and more.</p>
    </article>
  </section>
</Layout>
