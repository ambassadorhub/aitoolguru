---
// Layout
import SitesLayout from "@/layouts/SitesLayout.astro";
// Get  all posts from the "sites"  collection, which returns an unsorted array of post objects
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const sites = await getCollection("sites");
  const paths = sites.map((page) => {
    return {
      params: { slug: page.id },
      props: { page },
      trailingSlash: false,
    };
  });
  return paths;
}
const { page } = Astro.props;
const { Content } = await render(page);
// Check for screenshot
const toolId = page.id;
const hasScreenshot = ["1", "2", "3", "4", "5"].includes(toolId);
const screenshotSrc = hasScreenshot ? `/images/sites/${toolId}-screenshot.png` : null;
---

<SitesLayout frontmatter={page.data} hasScreenshot={hasScreenshot} screenshotSrc={screenshotSrc}>
  <Content />
</SitesLayout>
