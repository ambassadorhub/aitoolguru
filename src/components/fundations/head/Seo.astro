---
import { AstroSeo } from "@lexingtonthemes/seo";
---

<AstroSeo
  title="AI Tool Guru"
  description="Honest AI Tool Reviews for UK Small Businesses"
  canonical="https://aitoolguru.co.uk"
  openGraph={{
    url: "https://aitoolguru.co.uk",
    title: "AI Tool Guru",
    description: "Honest AI Tool Reviews for UK Small Businesses",
    images: [
      {
        url: "https://aitoolguru.co.uk/og-image.jpg",
        width: 1200,
        height: 630,
        alt: "AI Tool Guru - Honest AI Tool Reviews",
        type: "image/jpeg",
      },
    ],
    site_name: "AI Tool Guru",
    type: "website",
    locale: "en_GB",
  }}
  twitter={{
    handle: "@aitoolguru",
    site: "@aitoolguru",
    cardType: "summary_large_image",
  }}
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://aitoolguru.co.uk/" />
<meta property="og:title" content="AI Tool Guru" />
<meta
  property="og:description"
  content="Honest AI Tool Reviews for UK Small Businesses"
/>
<meta
  property="og:image"
  content="https://aitoolguru.co.uk/og-image.jpg"
/>

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="https://aitoolguru.co.uk/" />
<meta property="twitter:title" content="AI Tool Guru" />
<meta
  property="twitter:description"
  content="Honest AI Tool Reviews for UK Small Businesses"
/>
<meta
  property="twitter:image"
  content="https://aitoolguru.co.uk/og-image.jpg"
/>

<!-- Canonical URL -->
<link rel="canonical" href="https://aitoolguru.co.uk/" />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />
