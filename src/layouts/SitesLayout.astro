---
// Assets
import { Image } from "astro:assets";
// Layout
import BaseLayout from "./BaseLayout.astro";
// Fundation
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import ArrowupRight from "@/components/fundations/icons/ArrowUpRight.astro";
// Components
import BigCard from "@/components/sites/SiteCard.astro";
// Retrieve all posts from the "posts" collection
import { getCollection } from "astro:content";
const alltools = await getCollection("sites");
// Frontmatter
const { frontmatter } = Astro.props;
// Get tool ID from Astro.url or frontmatter
const toolId = Astro.url.pathname.match(/\/sites\/site\/(\d+)/)?.[1];
// Reference screenshot by number (e.g., 1-screenshot.png)
const screenshotSrc = toolId ? `/images/sites/${toolId}-screenshot` : null;
// Check if a screenshot exists for this tool
const hasScreenshot = ["1", "2", "3", "4", "5"].includes(toolId || "");
---

<BaseLayout showSearch={true}>
  <section>
    <Wrapper variant="standard" class="py-24">
      <div class="flex flex-wrap justify-between gap-4 items-start">
        <div class="max-w-xl text-balance">
          <Text
            tag="h1"
            variant="displayMD"
            class="text-base-900 font-display font-thin capitalize"
          >
            {frontmatter.title}
          </Text>
          <Text tag="p" variant="textBase" class="text-base-600 mt-2">
            {frontmatter.tagline}
          </Text>
          <Text tag="p" variant="textSM" class="text-base-500 mt-4">
            {frontmatter.description}
          </Text>
        </div>
        <Button
          isLink
          size="sm"
          variant="accent"
          href={frontmatter.live}
          title={`Visit ${frontmatter.title}`}
          class="shrink-0"
        >
          Visit Site
          <ArrowupRight slot="icon" class="size-4" />
        </Button>
      </div>
      <div class="p-8 bg-base-50 rounded-lg mt-12">
        {hasScreenshot && imgSrc ? (
          <div class="rounded-lg overflow-hidden border border-base-200 shadow-sm">
            <img 
              src={imgSrc} 
              alt={`${frontmatter.title} dashboard screenshot`}
              width="1920"
              height="1080"
              class="w-full h-auto"
              loading="eager"
            />
          </div>
        ) : (
          <div class="flex items-center justify-center h-48 bg-base-100 rounded border-2 border-dashed border-base-300">
            <Text tag="p" variant="textSM" class="text-base-400">
              Screenshot placeholder - add {frontmatter.title} screenshot to /src/images/sites/
            </Text>
          </div>
        )}
      </div>
      <dl class="mt-4 divide-y divide-base-100">
        {
          frontmatter.details.map((details) => (
            <div class="flex itmes-center gap-2 justify-between py-2">
              <dt>
                <Text
                  tag="h3"
                  variant="textSM"
                  class="text-base-900 font-medium"
                >
                  {details.label}
                </Text>
              </dt>
              <dd>
                <Text tag="p" variant="textSM" class="text-base-600">
                  {details.value}
                </Text>
              </dd>
            </div>
          ))
        }
      </dl>
      
      <!-- Affiliate CTA -->
      <div class="mt-12 p-8 bg-accent-50 border border-accent-200 rounded-lg text-center">
        <Text tag="h3" variant="textLG" class="text-accent-900 font-medium">
          Try {frontmatter.title} Free
        </Text>
        <Text tag="p" variant="textSM" class="text-accent-700 mt-2">
          Start your free trial today. No credit card required.
        </Text>
        <Button
          isLink
          size="md"
          variant="accent"
          href={frontmatter.live}
          class="mt-4"
        >
          Get Started Now
          <ArrowupRight slot="icon" class="size-4" />
        </Button>
      </div>
    </Wrapper>
  </section>
  <section>
    <Wrapper variant="standard" class="py-24">
      <div class="flex flex-wrap gap-4 justify-between items-center">
        <Text
          tag="h2"
          variant="displaySM"
          class="text-base-900 font-display font-thin">Latest additions</Text
        >
        <Button isLink size="sm" variant="muted" href="/sites/">
          See all tools
        </Button>
      </div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4 mt-8">
        {alltools.slice(0, 4).map((post) => <BigCard post={post} />)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
